[Unit]
Description=TITAN Mobile (control casa + consum)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -m titan.mobile.server
Restart=always
RestartSec=5
# Securizare: serviciul nu are nevoie de drepturi speciale.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__DIR__/data

[Install]
WantedBy=multi-user.target
