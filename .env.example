# API-ul este oprit implicit. Nu adăuga cheia reală în Git.
OPENAI_API_KEY=
TITAN_API_ENABLED=false
TITAN_API_FALLBACK_ON_UNKNOWN_COMMAND=false
TITAN_MONTHLY_REQUEST_LIMIT=100
TITAN_MONTHLY_BUDGET_EUR=3.00

# Wake word-ul local gratuit folosește modelul Vosk din models/.

# Aplicația de telefon. Pe Raspberry Pi se setează o valoare lungă, unică.
# Serverul rămâne pe 127.0.0.1 şi va fi expus numai prin Tailscale Serve.
TITAN_MOBILE_ACCESS_TOKEN=
TITAN_MOBILE_HOST=127.0.0.1
TITAN_MOBILE_PORT=8787
